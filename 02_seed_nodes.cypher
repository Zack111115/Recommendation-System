// tạo thêm node trùng ID. Đây đều là dữ liệu GIẢ LẬP của đồ án.
// ================================================================

// PHẦN A - Tạo 12 Category.
// Kiểm tra sau khi chạy: MATCH (cat:Category) RETURN count(cat); kết quả 12.
UNWIND [
  {id: "CAT01", name: "Laptop và máy tính", description: "Thiết bị máy tính cá nhân và màn hình"},
  {id: "CAT02", name: "Phụ kiện máy tính", description: "Thiết bị bổ trợ cho laptop và máy tính"},
  {id: "CAT03", name: "Điện thoại và máy tính bảng", description: "Thiết bị di động"},
  {id: "CAT04", name: "Phụ kiện điện thoại", description: "Phụ kiện bảo vệ và cấp nguồn cho thiết bị di động"},
  {id: "CAT05", name: "Thiết bị âm thanh", description: "Tai nghe, loa và phụ kiện âm thanh"},
  {id: "CAT06", name: "Đồ gia dụng", description: "Thiết bị gia dụng phổ biến"},
  {id: "CAT07", name: "Chăm sóc em bé", description: "Sản phẩm chăm sóc trẻ nhỏ"},
  {id: "CAT08", name: "Đồ uống và cà phê", description: "Đồ uống đóng gói và nguyên liệu pha chế"},
  {id: "CAT09", name: "Thể thao và ngoài trời", description: "Dụng cụ tập luyện và dã ngoại"},
  {id: "CAT10", name: "Chăm sóc cá nhân", description: "Sản phẩm vệ sinh và chăm sóc cá nhân"},
  {id: "CAT11", name: "Văn phòng phẩm", description: "Vật dụng học tập và văn phòng"},
  {id: "CAT12", name: "Đồ ăn nhẹ", description: "Bánh, hạt và thực phẩm ăn nhẹ"}
] AS row
MERGE (cat:Category {id: row.id})
SET cat.name = row.name,
    cat.description = row.description;

